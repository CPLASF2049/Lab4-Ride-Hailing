# Copy to .env for the local Node launcher or Docker Compose.
# All values are local course-demo defaults, not production secrets.

# --- host / entry ports ---
GATEWAY_PORT=8083
REGISTRY_PORT=8500
ORDER_PORT=3101
QUERY_PORT=3102
DRIVER_PORT=3103
DISPATCH_PORT=3104
PRICING_PORT=3105
HOST=127.0.0.1
DATA_DIR=data

# --- shared demo credentials (change together in every service) ---
AUTH_SECRET=lab3-demo-change-before-public-use
INTERNAL_TOKEN=lab3-local-internal

# --- service registry ---
# Docker Compose sets REGISTRY_URL=http://registry:8500; the local launcher sets 127.0.0.1.
REGISTRY_URL=http://127.0.0.1:8500

# --- order-query resilience (Lab 4) ---
DRIVER_TIMEOUT_MS=600
DRIVER_ATTEMPTS=2
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_WINDOW_MS=10000
CIRCUIT_OPEN_MS=8000
QUERY_RATE_CAPACITY=60
QUERY_RATE_REFILL=30

# --- dispatch timing ---
OFFER_TTL_MS=15000
DISPATCH_WAIT_MS=45000
DISPATCH_TICK_MS=300
